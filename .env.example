# ─── Supabase ───────────────────────────────────────────
# Get these from: supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key-here

# ─── Notes ──────────────────────────────────────────────
# Vite requires VITE_ prefix for env vars to be available in client code.
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.

# Optional. If set, Google Analytics loads only after the visitor clicks
# Accept on the cookie notice. Leave blank to skip it.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXX
